{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantica-dataagent.org/schemas/v1/document.schema.json",
  "title": "document",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "path",
    "content"
  ],
  "additionalProperties": false
}
